<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <UseWPF>true</UseWPF>
    <AssemblyName>ListForge</AssemblyName>
    <RootNamespace>ListForge</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <Version>2.1.35</Version>
    <FileVersion>2.1.35.0</FileVersion>
    <AssemblyVersion>2.1.35.0</AssemblyVersion>
    <ListForgeDistribution Condition="'$(ListForgeDistribution)' == ''">Development</ListForgeDistribution>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ListForge.Tests\**\*.cs" />
    <EmbeddedResource Remove="ListForge.Tests\**\*" />
    <None Remove="ListForge.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tesseract binaries bundled with the app -->
    <Content Include="tesseract\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.ico" Condition="Exists('Assets\logo.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Theme and control XAML as embedded resources so pack:// URI works -->
    <Resource Include="UI\Themes\DarkTheme.xaml"/>
    <Resource Include="UI\Themes\LightTheme.xaml"/>
    <Resource Include="UI\Themes\SisBoltTheme.xaml"/>
    <Resource Include="UI\Controls\SegmentedControl.xaml"/>
    <Resource Include="UI\Controls\AnimatedToggleSwitch.xaml"/>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ListForgeDistribution</_Parameter1>
      <_Parameter2>$(ListForgeDistribution)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
