<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="AnimatedToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="104"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                SnapsToDevicePixels="True">
            <Border x:Name="Track"
                    Background="{DynamicResource PanelAlt}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15"/>
            <Border x:Name="FocusCue"
                    BorderBrush="{DynamicResource PrimaryHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Margin="-2"
                    Opacity="0"/>
            <TextBlock x:Name="OnLabel"
                       Text="Avan&#x00E7;ado"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="11,0,0,0"
                       Opacity="0"/>
            <TextBlock x:Name="OffLabel"
                       Text="B&#x00E1;sico"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontWeight="Bold"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Border x:Name="Knob"
                    Width="26"
                    Height="26"
                    Margin="2"
                    HorizontalAlignment="Left"
                    CornerRadius="13"
                    Background="{DynamicResource TextBrush}">
              <Border.RenderTransform>
                <TranslateTransform x:Name="KnobTransform" X="0"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.22"/>
              </Border.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                     Storyboard.TargetProperty="X"
                                     To="74"
                                     Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobTransform"
                                     Storyboard.TargetProperty="X"
                                     To="0"
                                     Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource SuccessBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
              <Setter TargetName="OnLabel" Property="Opacity" Value="1"/>
              <Setter TargetName="OffLabel" Property="Opacity" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}"/>
              <Setter TargetName="Knob" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusCue" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Knob" Property="Opacity" Value="0.65"/>
              <Setter TargetName="OnLabel" Property="Opacity" Value="0.55"/>
              <Setter TargetName="OffLabel" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
