<UserControl x:Class="ListForge.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBg}">

  <Grid Margin="20,14,20,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="{Binding AboutProductName}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Identificação do produto, licença, suporte e caminhos da aplicação"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Produto" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AboutProductName}" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutVersion}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Edição" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutEdition}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Licenciado para" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AboutLicensedTo}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AboutTrialStatus}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Licença" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AboutLicenseSummary}" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Autor" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AboutAuthor}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contato" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutContact}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pasta de configuração" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutConfigPath}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pasta de logs" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AboutLogsPath}" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14">
          <StackPanel>
            <CheckBox Content="Incluir logs recentes"
                      IsChecked="{Binding SupportPackageIncludeLogs}"
                      Margin="0,0,0,10"/>
            <WrapPanel>
              <Button Content="Copiar informações"
                      Command="{Binding CopyAboutInfoCommand}"
                      Style="{StaticResource AccentButton}"
                      Margin="0,0,8,0"/>
              <Button Content="Gerar pacote de suporte"
                      Command="{Binding GenerateSupportPackageCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,0"/>
              <Button Content="Abrir pasta de configuração"
                      Command="{Binding OpenConfigFolderCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,0"/>
              <Button Content="Abrir pasta de logs"
                      Command="{Binding OpenLogsFolderCommand}"
                      Style="{StaticResource StdButton}"/>
            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
