<UserControl x:Class="ListForge.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBg}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </UserControl.Resources>

  <Grid Margin="20,14,20,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="{Binding AboutProductName}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Identificação do produto, licença, suporte e caminhos da aplicação"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Produto" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AboutProductName}" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutVersion}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Edição" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutEdition}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Licenciado para" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AboutLicensedTo}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AboutTrialStatus}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Licença" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AboutLicenseSummary}" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Atualiza&#x00E7;&#x00F5;es"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Vers&#x00E3;o instalada" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstalledVersion}" Margin="0,0,0,8"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Distribui&#x00E7;&#x00E3;o" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistributionDisplayName}" Margin="0,0,0,8"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="&#x00DA;ltima verifica&#x00E7;&#x00E3;o" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUpdateCheckSessionText}" Margin="0,0,0,8"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Vers&#x00E3;o dispon&#x00ED;vel" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"
                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AvailableUpdateVersionText}" Margin="0,0,0,8"
                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Fonte" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"
                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UpdateSourceText}"
                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <TextBlock Text="{Binding AvailableUpdateNotesText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}"/>

            <CheckBox Content="Verificar atualiza&#x00E7;&#x00F5;es ao iniciar"
                      IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"
                      Margin="0,12,0,0"/>

            <WrapPanel Margin="0,12,0,0">
              <Button Content="{Binding CheckUpdatesActionText}"
                      Command="{Binding CheckUpdatesCommand}"
                      Style="{StaticResource AccentButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsCheckUpdateActionVisible, Converter={StaticResource BoolToVisibility}}"/>
              <Button Content="{Binding DownloadUpdateActionText}"
                      Command="{Binding DownloadAvailableUpdateCommand}"
                      Style="{StaticResource AccentButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsDownloadUpdateActionVisible, Converter={StaticResource BoolToVisibility}}"/>
              <Button Content="Cancelar download"
                      Command="{Binding CancelUpdateDownloadCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsCancelUpdateActionVisible, Converter={StaticResource BoolToVisibility}}"/>
              <Button Content="Instalar atualiza&#x00E7;&#x00E3;o"
                      Command="{Binding InstallAvailableUpdateCommand}"
                      Style="{StaticResource AccentButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsInstallUpdateActionVisible, Converter={StaticResource BoolToVisibility}}"/>
              <Button Content="Abrir pasta"
                      Command="{Binding OpenDownloadedUpdateFolderCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsOpenUpdateFolderActionVisible, Converter={StaticResource BoolToVisibility}}"/>
              <Button Content="Ver notas da vers&#x00E3;o"
                      Command="{Binding OpenUpdateReleasePageCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,8"
                      Visibility="{Binding IsReleasePageActionVisible, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,2,0,0"
                         Visibility="{Binding IsCheckingUpdateVisible, Converter={StaticResource BoolToVisibility}}"/>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                         Height="8"
                         Margin="0,2,0,0"
                         Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding UpdateDownloadDetails}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Autor" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AboutAuthor}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contato" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutContact}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pasta de configuração" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,8"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutConfigPath}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pasta de logs" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AboutLogsPath}" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14">
          <StackPanel>
            <WrapPanel>
              <Button Content="Copiar informações"
                      Command="{Binding CopyAboutInfoCommand}"
                      Style="{StaticResource AccentButton}"
                      Margin="0,0,8,0"/>
              <Button Content="Abrir pasta de configuração"
                      Command="{Binding OpenConfigFolderCommand}"
                      Style="{StaticResource StdButton}"
                      Margin="0,0,8,0"/>
              <Button Content="Abrir pasta de logs"
                      Command="{Binding OpenLogsFolderCommand}"
                      Style="{StaticResource StdButton}"/>
            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
