<UserControl x:Class="ListForge.UI.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ListForge.UI.Controls"
             Background="{StaticResource AppBg}">

  <Grid>
  <DockPanel>

    <!-- ============================================================
         TOP: File bar
    ============================================================ -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
      <DockPanel Margin="12,8">
        <TextBlock x:Name="LblCurrentFile"
                   DockPanel.Dock="Right"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="380"/>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">
          <TextBlock Text="Perfil de trabalho"
                     Foreground="{StaticResource TextBrush}"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <TextBlock Text="Lista avançada"
                     Foreground="{StaticResource TextBrush}"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <ComboBox x:Name="CmbWorkProfile"
                    Width="190"
                    Margin="0,0,18,0"
                    ToolTip="Seleciona rapidamente um conjunto salvo de configura&#x00E7;&#x00F5;es."/>
          <ToggleButton x:Name="TglAdvancedList"
                        Style="{StaticResource AnimatedToggleSwitchStyle}"
                        ToolTip="Exibe opções avançadas da lista e do JSON."
                        KeyDown="AdvancedListToggle_KeyDown"/>
        </StackPanel>
        <WrapPanel>
          <Button Content="Abrir Lista"          Command="{Binding OpenInputFileCommand}"     Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
          <Button x:Name="BtnExtractFromLink"
                  Content="Extrair lista do link"
                  Style="{StaticResource StdButton}"
                  Margin="0,0,5,0"
                  IsEnabled="{Binding IsExtractFromLinkEnabled}"
                  Click="ExtractFromLinkMenuButton_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Criar nova lista"
                          Command="{Binding PlacementTarget.DataContext.ExtractNewListFromLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <MenuItem Header="Adicionar &#x00E0; lista atual"
                          Command="{Binding PlacementTarget.DataContext.AppendFromLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="Salvar Entrada"       Command="{Binding SaveInputFileCommand}"     Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
          <Button Content="Salvar Como"          Command="{Binding SaveInputAsFileCommand}"   Style="{StaticResource StdButton}" Margin="0,0,12,0"/>
          <Button Content="Desfazer"             Command="{Binding UndoCommand}"              Style="{StaticResource StdButton}" Margin="0,0,5,0" ToolTip="Ctrl+Z no editor"/>
          <Button Content="Pasta de backups"     Command="{Binding OpenBackupsFolderCommand}" Style="{StaticResource StdButton}"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- ============================================================
         BOTTOM: Footer actions
    ============================================================ -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <WrapPanel Grid.Column="0">
        <Button Content="Limpar tudo"  Command="{Binding ClearAllCommand}"   Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Copiar sa&#x00ED;da" Command="{Binding CopyOutputCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Salvar sa&#x00ED;da" Command="{Binding SaveOutputCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Aplicar altera&#x00E7;&#x00F5;es" Command="{Binding ApplyOutputEditsCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Descartar altera&#x00E7;&#x00F5;es" Command="{Binding DiscardOutputEditsCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button x:Name="BtnAdvancedSave" Content="Salvar avan&#x00E7;ado" Command="{Binding AdvancedSaveCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0" ToolTip="Salva entrada, sa&#x00ED;da e JSON usando a configura&#x00E7;&#x00E3;o de exporta&#x00E7;&#x00E3;o avan&#x00E7;ada."/>
        <Button x:Name="BtnCopyJson" Content="Copiar JSON" Command="{Binding CopyJsonCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
      </WrapPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="BtnGenerateJson" Content="Gerar JSON" Command="{Binding GenerateJsonCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button x:Name="BtnProcess"
                Content="{Binding ProcessButtonText}"
                Command="{Binding ProcessCommand}"
                Style="{StaticResource AccentButton}"
                PreviewMouseDown="ProcessButton_PreviewMouseDown"
                RenderTransformOrigin="0.5,0.5">
          <Button.RenderTransform>
            <ScaleTransform x:Name="ProcessButtonScale" ScaleX="1" ScaleY="1"/>
          </Button.RenderTransform>
        </Button>
      </WrapPanel>
    </Grid>

    <!-- ============================================================
         MIDDLE: Collapsible panels + split editor
    ============================================================ -->
    <DockPanel>

      <!-- Preparation panel -->
      <Expander DockPanel.Dock="Top" Header="&#x25B6;  Prepara&#x00E7;&#x00E3;o da lista" Margin="0,0,0,6" Padding="12,8">
        <StackPanel Margin="4,6,4,4">
          <WrapPanel>
            <TextBlock Text="Separador da entrada" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSeparator" Width="80" Style="{StaticResource FormEntry}" Margin="0,0,8,0"/>
            <Button Content="Padr&#x00E3;o (,)" Command="{Binding ResetSeparatorCommand}" Style="{StaticResource StdButton}" Margin="0,0,14,0"/>
            <Button Content="Remover espa&#x00E7;os" Command="{Binding CleanSpacesCommand}" Style="{StaticResource StdButton}" Margin="0,0,22,0"/>
            <TextBlock Text="Capitaliza&#x00E7;&#x00E3;o" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbCaseMode" Width="220" Margin="0,0,22,0"/>
            <TextBlock Text="Ordena&#x00E7;&#x00E3;o" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbSortMode" Width="140"/>
          </WrapPanel>

          <WrapPanel x:Name="PnlBulkAppend" Margin="0,10,0,0">
            <TextBlock Text="Adicionar:" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox x:Name="ChkApplySock" Content="Mei&#x00E3;o" IsChecked="True" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbBulkSock" Width="170" Margin="0,0,22,0"/>
            <Border Width="2" Height="36" Background="{StaticResource BorderBrush}" Margin="0,0,22,0"/>
            <CheckBox x:Name="ChkApplySize" Content="Tamanho" IsChecked="True" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtBulkSize" Width="150" Style="{StaticResource FormEntry}" Margin="0,0,16,0"/>
            <Button Content="Na sele&#x00E7;&#x00E3;o" Click="AppendSelected_Click" Style="{StaticResource StdButton}" Margin="0,0,8,0"/>
            <Button Content="Em todas" Click="AppendAll_Click" Style="{StaticResource StdButton}"/>
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- Search panel -->
      <Expander DockPanel.Dock="Top" Header="&#x25B6;  Localizar / Substituir" Margin="0,0,0,6" Padding="12,8">
        <StackPanel Margin="4,6,4,4">
          <WrapPanel>
            <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtFind" Width="200" Style="{StaticResource FormEntry}" Margin="0,0,14,0"/>
            <TextBlock Text="Substituir por" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtReplace" Width="200" Style="{StaticResource FormEntry}" Margin="0,0,14,0"/>
            <CheckBox x:Name="ChkMatchCase" Content="Diferenciar mai/min" VerticalAlignment="Center"/>
          </WrapPanel>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Anterior" Command="{Binding FindPreviousCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Pr&#x00F3;ximo" Command="{Binding FindNextCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Substituir" Command="{Binding ReplaceCurrentCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Substituir tudo" Command="{Binding ReplaceAllCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Limpar destaque" Command="{Binding ClearSearchHighlightCommand}" Style="{StaticResource StdButton}"/>
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- Editor body: left / right split -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Entrada / edi&#x00E7;&#x00E3;o"
                       FontSize="13" FontWeight="Bold"
                       Margin="12,10,12,6"/>
            <Grid>
              <ctrl:LineNumberedTextBox x:Name="LnbInput"
                                        FontSize="{Binding EditorFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HighlightedLineNumbers="{Binding ValidationHighlightLines}"
                                        Margin="0,0,0,0"/>
              <Canvas x:Name="ForgeInputSparks"
                      IsHitTestVisible="False"
                      ClipToBounds="True"/>
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Sa&#x00ED;da"
                       FontSize="13" FontWeight="Bold"
                       Margin="12,10,12,6"/>

            <TabControl x:Name="OutputTabs"
                        DockPanel.Dock="Top"
                        Margin="12,0,12,6"
                        SelectionChanged="OutputTabs_SelectionChanged">
              <TabItem Header="Lista organizada" Tag="list"/>
              <TabItem x:Name="TabJson" Header="Pr&#x00E9;via JSON" Tag="json"/>
            </TabControl>

            <Grid>
              <ctrl:LineNumberedTextBox x:Name="LnbOutput"
                                        FontSize="{Binding EditorFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="{Binding IsGeneratedOutputReadOnly}"
                                        Visibility="Visible"/>
              <Canvas x:Name="ForgeOutputSparks"
                      IsHitTestVisible="False"
                      ClipToBounds="True"/>
              <ctrl:LineNumberedTextBox x:Name="LnbJson"
                                        FontSize="{Binding EditorFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="{Binding IsGeneratedOutputReadOnly}"
                                        Visibility="Collapsed"/>
              <Canvas x:Name="ForgeJsonSparks"
                      IsHitTestVisible="False"
                      ClipToBounds="True"
                      Visibility="Collapsed"/>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </DockPanel>
  <Border x:Name="ForgeWindowHeat"
          IsHitTestVisible="False"
          Opacity="0">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#00E0571B" Offset="0"/>
        <GradientStop Color="#30E0571B" Offset="0.46"/>
        <GradientStop Color="#22FFC766" Offset="0.72"/>
        <GradientStop Color="#00FFC766" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
  </Border>
  <Canvas x:Name="ForgeWindowSparks"
          IsHitTestVisible="False"
          ClipToBounds="True"/>
  </Grid>
</UserControl>
