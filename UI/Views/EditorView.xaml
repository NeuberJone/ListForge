<UserControl x:Class="ListForge.UI.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ListForge.UI.Controls"
             Background="{StaticResource AppBg}">

  <DockPanel>

    <!-- ============================================================
         TOP: File bar
    ============================================================ -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
      <DockPanel Margin="12,8">
        <TextBlock x:Name="LblCurrentFile"
                   DockPanel.Dock="Right"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="380"/>
        <WrapPanel>
          <Button Content="Abrir Lista"          Command="{Binding OpenInputFileCommand}"    Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
          <Button Content="Extrair do link"       Command="{Binding ExtractFromLinkCommand}"  Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
          <Button Content="Salvar Entrada"        Command="{Binding SaveInputFileCommand}"    Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
          <Button Content="Salvar Como"           Command="{Binding SaveInputAsFileCommand}"  Style="{StaticResource StdButton}" Margin="0,0,12,0"/>
          <Button Content="Desfazer"              Command="{Binding UndoCommand}"             Style="{StaticResource StdButton}" Margin="0,0,5,0" ToolTip="Ctrl+Z no editor"/>
          <Button Content="Pasta de backups"      Command="{Binding OpenBackupsFolderCommand}" Style="{StaticResource StdButton}"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- ============================================================
         BOTTOM: Footer actions
    ============================================================ -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <WrapPanel Grid.Column="0">
        <Button Content="Limpar tudo"  Command="{Binding ClearAllCommand}"    Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Copiar saída" Command="{Binding CopyOutputCommand}"  Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Salvar saída" Command="{Binding SaveOutputCommand}"  Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button x:Name="BtnCopyJson"   Content="Copiar JSON" Command="{Binding CopyJsonCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
      </WrapPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="BtnGenerateJson" Content="Gerar JSON" Command="{Binding GenerateJsonCommand}" Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
        <Button Content="Processar"      Command="{Binding ProcessCommand}"    Style="{StaticResource AccentButton}"/>
      </WrapPanel>
    </Grid>

    <!-- ============================================================
         MIDDLE: Collapsible panels + split editor
    ============================================================ -->
    <DockPanel>

      <!-- Preparation panel -->
      <Expander DockPanel.Dock="Top" Header="▶  Preparação da lista" Margin="0,0,0,6" Padding="12,8">
        <WrapPanel Margin="4,6,4,4">
          <TextBlock Text="Separador da entrada" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="TxtSeparator" Width="60" Style="{StaticResource FormEntry}" Margin="0,0,6,0"/>
          <Button Content="Padrão (,)" Command="{Binding ResetSeparatorCommand}" Style="{StaticResource StdButton}" Margin="0,0,14,0"/>
          <Button Content="Remover espaços" Command="{Binding CleanSpacesCommand}" Style="{StaticResource StdButton}" Margin="0,0,20,0"/>
          <TextBlock Text="Capitalização" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="CmbCaseMode" Width="160"/>
        </WrapPanel>
      </Expander>

      <!-- Search panel -->
      <Expander DockPanel.Dock="Top" Header="▶  Localizar / Substituir" Margin="0,0,0,6" Padding="12,8">
        <StackPanel Margin="4,6,4,4">
          <WrapPanel>
            <TextBlock Text="Localizar" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtFind" Width="200" Style="{StaticResource FormEntry}" Margin="0,0,14,0"/>
            <TextBlock Text="Substituir por" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtReplace" Width="200" Style="{StaticResource FormEntry}" Margin="0,0,14,0"/>
            <CheckBox x:Name="ChkMatchCase" Content="Diferenciar mai/min" VerticalAlignment="Center"/>
          </WrapPanel>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Anterior"        Command="{Binding FindPreviousCommand}"        Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Próximo"         Command="{Binding FindNextCommand}"            Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Substituir"      Command="{Binding ReplaceCurrentCommand}"      Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Substituir tudo" Command="{Binding ReplaceAllCommand}"          Style="{StaticResource StdButton}" Margin="0,0,5,0"/>
            <Button Content="Limpar destaque" Command="{Binding ClearSearchHighlightCommand}" Style="{StaticResource StdButton}"/>
          </WrapPanel>
        </StackPanel>
      </Expander>

      <!-- Editor body: left / right split -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: input with line numbers -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Entrada / edição"
                       FontSize="13" FontWeight="Bold"
                       Margin="12,10,12,6"/>
            <ctrl:LineNumberedTextBox x:Name="LnbInput"
                                      Margin="0,0,0,0"/>
          </DockPanel>
        </Border>

        <!-- Right: output with line numbers -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Saída"
                       FontSize="13" FontWeight="Bold"
                       Margin="12,10,12,6"/>

            <TabControl x:Name="OutputTabs"
                        DockPanel.Dock="Top"
                        Margin="12,0,12,6"
                        SelectionChanged="OutputTabs_SelectionChanged">
              <TabItem Header="Lista organizada" Tag="list"/>
              <TabItem x:Name="TabJson" Header="Prévia JSON" Tag="json"/>
            </TabControl>

            <ctrl:LineNumberedTextBox x:Name="LnbOutput" IsReadOnly="True" Visibility="Visible"/>
            <ctrl:LineNumberedTextBox x:Name="LnbJson"   IsReadOnly="True" Visibility="Collapsed"/>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
