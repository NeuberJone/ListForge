<UserControl x:Class="ListForge.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBg}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Histórico"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="18"
                     FontWeight="Bold"/>
          <TextBlock Text="Últimos processamentos com arquivo de saída gerado."
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="12"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Content="Abrir pasta da saída"
                  Command="{Binding OpenSelectedHistoryOutputCommand}"
                  Style="{StaticResource StdButton}"
                  Margin="0,0,6,0"/>
          <Button Content="Limpar histórico"
                  Command="{Binding ClearProcessingHistoryCommand}"
                  Style="{StaticResource StdButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <DataGrid ItemsSource="{Binding ProcessingHistoryEntries}"
                SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                SelectionMode="Single"
                Background="{StaticResource PanelBg}"
                Foreground="{StaticResource TextBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                RowBackground="{StaticResource PanelBg}"
                AlternatingRowBackground="{StaticResource PanelAlt}"
                RowHeaderWidth="0"
                HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                VerticalGridLinesBrush="{StaticResource BorderBrush}">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
          </Style>
          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
              <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style x:Key="HistoryCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Arquivo" Binding="{Binding SourceDisplayName}" Width="220" ElementStyle="{StaticResource HistoryCellText}"/>
          <DataGridTextColumn Header="Data" Binding="{Binding ProcessedAtDisplay}" Width="150" ElementStyle="{StaticResource HistoryCellText}"/>
          <DataGridTextColumn Header="Linhas" Binding="{Binding ProcessedLineCount}" Width="80" ElementStyle="{StaticResource HistoryCellText}"/>
          <DataGridTextColumn Header="Saída" Binding="{Binding OutputPath}" Width="*" ElementStyle="{StaticResource HistoryCellText}"/>
        </DataGrid.Columns>
      </DataGrid>

      <Border Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowEmptyProcessingHistory}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="Nenhum processamento foi registrado ainda."
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
