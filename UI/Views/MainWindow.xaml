<Window x:Class="ListForge.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ListForge.UI.Views"
        Title="ListForge"
        Width="1540" Height="920"
        MinWidth="1320" MinHeight="780"
        Background="{StaticResource AppBg}"
        Style="{StaticResource AppWindowStyle}">

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <ColumnDefinition Width="210"/>
      <!-- Content -->
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============================================================
         SIDEBAR
    ============================================================ -->
    <Border x:Name="SidebarPanel"
            Grid.Column="0"
            Background="{StaticResource SidebarBg}"
            BorderBrush="{StaticResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">

        <!-- Logo / title -->
        <StackPanel DockPanel.Dock="Top" Margin="14,16,14,20">
          <TextBlock x:Name="LogoTitle"
                     Text="ListForge"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="Organização e transformação de listas"
                     x:Name="LogoSubtitle"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="10" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Nav -->
        <StackPanel DockPanel.Dock="Top" Margin="10,0">
          <Button x:Name="BtnNavEditor"
                  Content="Editor"
                  Style="{StaticResource SidebarButtonActive}"
                  Click="NavEditor_Click"
                  Margin="0,0,0,4"/>
          <Button x:Name="BtnNavHistory"
                  Content="Histórico"
                  Style="{StaticResource SidebarButton}"
                  Click="NavHistory_Click"
                  Margin="0,0,0,4"/>
          <Button x:Name="BtnNavSettings"
                  Content="Configurações"
                  Style="{StaticResource SidebarButton}"
                  Click="NavSettings_Click"
                  Margin="0,0,0,4"/>
          <Button x:Name="BtnNavManual"
                  Content="Manual"
                  Style="{StaticResource SidebarButton}"
                  Click="NavManual_Click"
                  Margin="0,0,0,4"/>
          <Button x:Name="BtnNavAbout"
                  Content="Sobre"
                  Style="{StaticResource SidebarButton}"
                   Click="NavAbout_Click"
                   Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Margin="10,0,10,14">
          <Button Content="Gerar pacote de suporte"
                  Command="{Binding GenerateSupportPackageCommand}"
                  Style="{StaticResource SidebarButton}"
                  Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel x:Name="AdvancedListPanel"
                    DockPanel.Dock="Top"
                    Margin="14,24,14,0">
          <TextBlock x:Name="AdvancedListTitle"
                     Text="Lista avan&#x00E7;ada"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="13"
                     FontWeight="Bold"
                     Margin="0,0,0,6"/>
          <TextBlock x:Name="AdvancedListSubtitle"
                     Text="Ordem dos tipos de pe&#x00E7;a no JSON"
                     Foreground="{StaticResource TextMutedBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10"/>
          <ItemsControl x:Name="SidebarAdvancedJsonPieceSlots">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding PositionLabel}"
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="11"
                             FontWeight="Bold"
                             Margin="0,0,0,3"/>
                  <ComboBox Width="170"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding AvailablePieceOptions}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Key"
                            SelectedValue="{Binding SelectedPieceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- ============================================================
         RIGHT SIDE
    ============================================================ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <!-- Topbar -->
        <RowDefinition Height="58"/>
        <!-- Content -->
        <RowDefinition Height="*"/>
        <!-- Status bar -->
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- Topbar -->
      <Border x:Name="TopbarPanel"
              Grid.Row="0"
              Background="{StaticResource TopbarBg}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <TextBlock x:Name="TopbarTitle"
                   Text="Editor"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="15" FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="16,0"/>
      </Border>

      <!-- Views (layered via Visibility) -->
      <Grid x:Name="ViewsHost" Grid.Row="1">
        <views:EditorView x:Name="EditorViewControl" Visibility="Visible"/>
        <views:HistoryView x:Name="HistoryViewControl" Visibility="Collapsed"/>
        <views:SettingsView x:Name="SettingsViewControl" Visibility="Collapsed"/>
        <views:ManualView x:Name="ManualViewControl" Visibility="Collapsed"/>
        <views:AboutView x:Name="AboutViewControl" Visibility="Collapsed"/>
      </Grid>

      <!-- Status bar -->
      <Border x:Name="StatusbarPanel"
              Grid.Row="2"
              Background="{StaticResource TopbarBg}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock x:Name="StatusLabel"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Margin="14,0"
                   TextTrimming="CharacterEllipsis"/>
      </Border>

    </Grid>
  </Grid>
</Window>
