<UserControl x:Class="ListForge.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBg}">

  <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,18,28,28">

      <!-- ============================================================
           Seção: Exibição
      ============================================================ -->
      <GroupBox Header="Exibição">
        <StackPanel Margin="0,4,0,0">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left"
                       Text="Tamanho da fonte das listas:"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <TextBlock x:Name="TxtEditorFontSize"
                       DockPanel.Dock="Right"
                       Width="46"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="12,0,0,0"/>
            <Slider x:Name="SldEditorFontSize"
                    Minimum="8"
                    Maximum="32"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <!-- ============================================================
           Seção: Modo Forja
      ============================================================ -->
      <GroupBox Header="Modo Forja">
        <StackPanel Margin="0,4,0,0">
          <CheckBox Content="Ativar Modo Forja"
                    IsChecked="{Binding ForgeModeEnabled, Mode=TwoWay}"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>
          <TextBlock Text="Efeitos visuais opcionais inspirados em aço, calor, faíscas e impacto. Não alteram o processamento das listas."
                      Foreground="{StaticResource TextMutedBrush}"
                      TextWrapping="Wrap"
                      Margin="0,0,0,10"/>
          <WrapPanel>
            <CheckBox Content="Calor"
                      IsChecked="{Binding ForgeHeatEnabled, Mode=TwoWay}"
                      Margin="0,0,18,6"/>
            <CheckBox Content="Faíscas"
                      IsChecked="{Binding ForgeSparksEnabled, Mode=TwoWay}"
                      Margin="0,0,18,6"/>
            <CheckBox Content="Impacto"
                      IsChecked="{Binding ForgeImpactEnabled, Mode=TwoWay}"
                      Margin="0,0,18,6"/>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <!-- ============================================================
           Seção: Perfis de trabalho
      ============================================================ -->
      <GroupBox Header="Perfis de trabalho">
        <StackPanel Margin="0,4,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Perfil ativo:"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <ComboBox x:Name="CmbSettingsWorkProfile"
                      Grid.Column="1"
                      ToolTip="Seleciona um perfil de trabalho salvo."/>
            <TextBlock x:Name="TxtWorkProfileStatus"
                       Grid.Column="2"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
          </Grid>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="Criar perfil"
                    Command="{Binding CreateWorkProfileCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Salvar alterações no perfil"
                    Command="{Binding SaveWorkProfileCommand}"
                    Style="{StaticResource AccentButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Descartar alterações"
                    Command="{Binding DiscardWorkProfileChangesCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Renomear"
                    Command="{Binding RenameWorkProfileCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Duplicar"
                    Command="{Binding DuplicateWorkProfileCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Excluir"
                    Command="{Binding DeleteWorkProfileCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Restaurar padrão"
                    Command="{Binding RestoreDefaultWorkProfileCommand}"
                    Style="{StaticResource StdButton}"/>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <!-- ============================================================
           Seção: Saída
      ============================================================ -->
      <GroupBox Header="Saída">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <CheckBox x:Name="ChkUseDefaultOutputDir"
                    Grid.Row="0" Grid.Column="0"
                    Content="Usar pasta padrão de saída:"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
          <DockPanel Grid.Row="0" Grid.Column="1">
            <Button DockPanel.Dock="Right"
                    Content="Escolher"
                    Command="{Binding PickOutputFolderCommand}"
                    Style="{StaticResource StdButton}"
                    Margin="8,0,0,0"/>
            <TextBox x:Name="TxtOutputDir"
                     Style="{StaticResource FormEntry}"
                     IsEnabled="{Binding OutputDirEnabled}"/>
          </DockPanel>

          <CheckBox x:Name="ChkUseDefaultListName"
                    Grid.Row="2" Grid.Column="0"
                    Content="Usar nome padrão de lista:"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>
          <TextBox x:Name="TxtDefaultListName"
                   Grid.Row="2" Grid.Column="1"
                   Style="{StaticResource FormEntry}"
                   IsEnabled="{Binding DefaultListNameEnabled}"/>

          <TextBlock Grid.Row="4" Grid.Column="0"
                     Text="Capitalização padrão:"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <ComboBox x:Name="CmbDefaultCase"
                    Grid.Row="4" Grid.Column="1"
                    Width="200"
                    HorizontalAlignment="Left"/>

          <TextBlock Grid.Row="6" Grid.Column="0"
                     Text="Separador padrão da entrada:"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <TextBox x:Name="TxtDefaultSeparator"
                   Grid.Row="6" Grid.Column="1"
                   Style="{StaticResource FormEntry}"
                   Width="80"
                   HorizontalAlignment="Left"/>

          <CheckBox x:Name="ChkAllowOutputEditing"
                    Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                    Content="Permitir edi&#x00E7;&#x00E3;o da sa&#x00ED;da e do JSON nesta sess&#x00E3;o"
                    VerticalAlignment="Center"/>
        </Grid>
      </GroupBox>

      <!-- ============================================================
           Seção: Exportação avançada
      ============================================================ -->
      <GroupBox Header="Exporta&#x00E7;&#x00E3;o avan&#x00E7;ada">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Tipo de Salvar avan&#x00E7;ado:" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="CmbAdvancedSaveMode" Width="180"/>
        </StackPanel>
      </GroupBox>

      <!-- ============================================================
           Seção: Tema
      ============================================================ -->
      <GroupBox Header="Tema">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ComboBox x:Name="CmbTheme" Width="200"/>
        </StackPanel>
      </GroupBox>

      <!-- ============================================================
           Seção: Tamanhos — Masculino
      ============================================================ -->
      <GroupBox Header="Tamanhos — Masculino">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanhos base:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtMaleBase" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Ex: PP, P, M, G, GG (separados por vírgula)"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtMalePre" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Opcional. Ex: EX (gerará EXPP, EXP, ...)"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Sufixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtMaleSuf" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Opcional. Ex: G (gerará PPG, PG, ...)"/>
        </Grid>
      </GroupBox>

      <!-- Tamanhos — Feminino -->
      <GroupBox Header="Tamanhos — Feminino">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanhos base:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtFemaleBase" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormEntry}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtFemalePre" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Ex: BL (para BLPP, BLP, ...)"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Sufixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtFemaleSuf" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormEntry}"/>
        </Grid>
      </GroupBox>

      <!-- Tamanhos — Infantil -->
      <GroupBox Header="Tamanhos — Infantil">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanhos base:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtChildBase" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Ex: 2, 4, 6, 8, 10, 12, 14, 16"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtChildPre" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormEntry}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Sufixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtChildSuf" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Ex: A (para 2A, 4A, ...)"/>
        </Grid>
      </GroupBox>

      <!-- Tamanhos — Meiao -->
      <GroupBox Header="Tamanhos — Meiao">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanhos base:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtSockBase" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormEntry}"
                   ToolTip="Ex: JUVENIL, ADULTO, INFANTIL"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtSockPre" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormEntry}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Sufixos:" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtSockSuf" Grid.Row="4" Grid.Column="1" Style="{StaticResource FormEntry}"/>
        </Grid>
      </GroupBox>

      <!-- Resumo de tamanhos -->
      <GroupBox Header="Resumo dos tamanhos válidos atuais">
        <TextBlock x:Name="TxtSizeSummary"
                   FontFamily="Consolas"
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"/>
      </GroupBox>

      <!-- ============================================================
           Botões de ação
      ============================================================ -->
      <WrapPanel Margin="0,4,0,0">
        <Button Content="Salvar configurações"
                Command="{Binding SaveSettingsCommand}"
                Style="{StaticResource AccentButton}"
                Margin="0,0,10,0"
                Padding="16,8"/>
        <Button Content="Importar configurações"
                Command="{Binding ImportSettingsCommand}"
                Style="{StaticResource StdButton}"
                Margin="0,0,10,0"
                Padding="14,8"/>
        <Button Content="Exportar configurações"
                Command="{Binding ExportSettingsCommand}"
                Style="{StaticResource StdButton}"
                Margin="0,0,10,0"
                Padding="14,8"/>
        <Button Content="Restaurar padrão (geral)"
                Command="{Binding RestoreDefaultSettingsCommand}"
                Style="{StaticResource StdButton}"
                Margin="0,0,10,0"
                Padding="14,8"/>
        <Button Content="Restaurar tamanhos padrão"
                Command="{Binding RestoreDefaultSizesCommand}"
                Style="{StaticResource StdButton}"
                Margin="0,0,10,0"
                Padding="14,8"/>
        <Button Content="Abrir pasta de logs"
                Command="{Binding OpenLogsFolderCommand}"
                Style="{StaticResource StdButton}"
                Padding="14,8"/>
      </WrapPanel>

    </StackPanel>
  </ScrollViewer>
  <Canvas x:Name="ForgeSettingsSparks"
          IsHitTestVisible="False"
          ClipToBounds="True"/>
  </Grid>
</UserControl>
